+    // Round-up division (hardening: use wherever the user receives value)
+    function bdivUp(uint a, uint b)
+        internal pure
+        returns (uint)
+    {
+        require(b != 0, "ERR_DIV_ZERO");
+        uint c0 = a * BONE;
+        require(a == 0 || c0 / a == BONE, "ERR_DIV_INTERNAL");
+        return c0 == 0 ? 0 : (c0 - 1) / b + 1;
+    }
+
+    // Round-down multiplication (hardening)
+    function bmulDown(uint a, uint b)
+        internal pure
+        returns (uint)
+    {
+        uint c0 = a * b;
+        require(a == 0 || c0 / a == b, "ERR_MUL_OVERFLOW");
+        return c0 / BONE;
+    }
